# HTTPS mode (cert.pem and key.pem in nginx/certs/): HTTP redirected with 301, HTTPS serves the app.
# Rendered by envsubst: HTTPS_PORT_SUFFIX is set by entrypoint-tls.sh (":<HTTPS_PORT>", empty for 443).
server {
    listen 80;
    server_name _;

    return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
}

# HTTPS server: frontend files and /api/ proxied to the backend
server {
    listen 443 ssl;
    server_name _;
    client_max_body_size 1m;

    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Upload of a document: the body limit is the file limit plus 1 MB of multipart framing (UPLOAD_BODY_LIMIT_MB,
    # computed by entrypoint-tls.sh from MAX_UPLOAD_SIZE_MB). Above it Nginx answers with the JSON error body of the
    # backend (file_too_large); the rest of /api/ keeps the limit of the server block.
    location ~ ^/api/kbs/[^/]+/documents$ {
        client_max_body_size ${UPLOAD_BODY_LIMIT_MB}m;
        error_page 413 @file_too_large;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location @file_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"file_too_large","message":"The file is too large"}}';
    }

    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
