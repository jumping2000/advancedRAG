# HTTPS mode (cert.pem and key.pem in nginx/certs/): HTTP redirected with 301, HTTPS serves the app.
# Rendered by envsubst: HTTPS_PORT_SUFFIX is set by entrypoint-tls.sh (":<HTTPS_PORT>", empty for 443).
server {
    listen 80;
    server_name _;

    return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
}

# HTTPS server: frontend files and /api/ proxied to the backend
server {
    listen 443 ssl;
    server_name _;
    client_max_body_size 1m;

    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Always "https" here, whatever the client sent: the backend sets the cookie Secure from it
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
