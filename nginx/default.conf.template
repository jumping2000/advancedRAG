# HTTP-only mode (no cert.pem and key.pem in nginx/certs/, see entrypoint-tls.sh).
# HTTP server: frontend files and /api/ proxied to the backend
server {
    listen 80;
    server_name _;
    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Always "http" here, whatever the client sent: the backend sets the cookie Secure from it
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
