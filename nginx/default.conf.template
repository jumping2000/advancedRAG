# HTTP-only mode (no cert.pem and key.pem in nginx/certs/, see entrypoint-tls.sh).
# HTTP server: frontend files and /api/ proxied to the backend
server {
    listen 80;
    server_name _;
    client_max_body_size 1m;

    # Upload of a document: the body limit is the file limit plus 1 MB of multipart framing (UPLOAD_BODY_LIMIT_MB,
    # computed by entrypoint-tls.sh from MAX_UPLOAD_SIZE_MB). Above it Nginx answers with the JSON error body of the
    # backend (file_too_large); the rest of /api/ keeps the limit of the server block.
    location ~ ^/api/kbs/[^/]+/documents$ {
        client_max_body_size ${UPLOAD_BODY_LIMIT_MB}m;
        error_page 413 @file_too_large;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location @file_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"file_too_large","message":"The file is too large"}}';
    }

    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
