# Copy to .env (ignored by git) and fill in the empty values. SPEC-2026-11-06-fase-1-fondazioni.

# Database password: any character is allowed (the backend never pastes it into DATABASE_URL);
# if it contains "$", write it in single quotes
POSTGRES_PASSWORD=
# Host port of Nginx, the only published port
HTTP_PORT=80
# Host port of Nginx for HTTPS, used only with compose.tls.yaml
# (docker compose -f compose.yaml -f compose.tls.yaml up --build); HTTPS needs cert.pem and key.pem in nginx/certs/
HTTPS_PORT=443

# Database and Redis. With docker compose they are set by compose.yaml; set them only to run the backend outside
# compose, e.g. postgresql+asyncpg://rag@127.0.0.1:5432/ragdb (password taken from POSTGRES_PASSWORD) and
# redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=

# External services (not started by docker compose)
OLLAMA_BASE_URL=http://ollama.example.internal:11434
DOCLING_BASE_URL=http://docling.example.internal:5001
# Seconds to wait for each dependency in GET /api/health
HEALTH_CHECK_TIMEOUT_SECONDS=2

# First admin, created at the first start when no active admin exists; ignored afterwards
# (the backend stops with a message naming the variable if one is missing when the admin must be created)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Minutes without requests after which a session expires
SESSION_IDLE_TIMEOUT_MINUTES=480

# Folder of the uploaded files, kept only until the document is processed. compose.yaml fixes it to /data/uploads
# (the `uploads` volume); set it only to run the backend outside compose
UPLOAD_DIR=/data/uploads
# Largest file the admin can upload, in MB (Nginx and the backend both enforce it)
MAX_UPLOAD_SIZE_MB=20

# Indexing profile: the embedding model (Ollama) and the size of its vectors, 1-2000. Another model or size starts a
# new profile; documents already indexed keep theirs. The size must be the one the model returns
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# The chunks go to Ollama in groups of this many texts (at least 1), each request waits at most this many seconds
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120
# Chunk size in words: CHUNK_MIN_WORDS <= CHUNK_TARGET_WORDS <= CHUNK_MAX_WORDS; the overlap between consecutive chunks
# of a section is this percent of CHUNK_TARGET_WORDS (0-99). Changing them starts a new profile
CHUNK_TARGET_WORDS=300
CHUNK_MIN_WORDS=50
CHUNK_MAX_WORDS=450
CHUNK_OVERLAP_PERCENT=15
