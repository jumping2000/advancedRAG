# Copy to .env (ignored by git) and fill in the empty values. SPEC-2026-11-06-fase-1-fondazioni.

# Database password: any character is allowed (the backend never pastes it into DATABASE_URL);
# if it contains "$", write it in single quotes
POSTGRES_PASSWORD=
# Host port of Nginx, the only published port
HTTP_PORT=80
# Host port of Nginx for HTTPS, answered only when nginx/certs/ holds cert.pem and key.pem
HTTPS_PORT=443

# Database and Redis. With docker compose they are set by compose.yaml; set them only to run the backend outside
# compose, e.g. postgresql+asyncpg://rag@127.0.0.1:5432/ragdb (password taken from POSTGRES_PASSWORD) and
# redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=

# External services (not started by docker compose)
OLLAMA_BASE_URL=http://ollama.example.internal:11434
DOCLING_BASE_URL=http://docling.example.internal:5001
# Seconds to wait for each dependency in GET /api/health
HEALTH_CHECK_TIMEOUT_SECONDS=2
