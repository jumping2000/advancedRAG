# Copy to .env (ignored by git) and fill in the empty values. SPEC-2026-11-06-fase-1-fondazioni.

# Database password: any character is allowed (the backend never pastes it into DATABASE_URL);
# if it contains "$", write it in single quotes
POSTGRES_PASSWORD=
# Host port of Nginx, the only published port
HTTP_PORT=80
# Host port of Nginx for HTTPS, used only with compose.tls.yaml
# (docker compose -f compose.yaml -f compose.tls.yaml up --build); HTTPS needs cert.pem and key.pem in nginx/certs/
HTTPS_PORT=443

# Database and Redis. With docker compose they are set by compose.yaml; set them only to run the backend outside
# compose, e.g. postgresql+asyncpg://rag@127.0.0.1:5432/ragdb (password taken from POSTGRES_PASSWORD) and
# redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=

# External services (not started by docker compose)
OLLAMA_BASE_URL=http://ollama.example.internal:11434
DOCLING_BASE_URL=http://docling.example.internal:5001
# Seconds to wait for each dependency in GET /api/health
HEALTH_CHECK_TIMEOUT_SECONDS=2

# First admin, created at the first start when no active admin exists; ignored afterwards
# (the backend stops with a message naming the variable if one is missing when the admin must be created)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Minutes without requests after which a session expires
SESSION_IDLE_TIMEOUT_MINUTES=480

# Folder of the uploaded files, kept only until the document is processed. compose.yaml fixes it to /data/uploads
# (the `uploads` volume); set it only to run the backend outside compose
UPLOAD_DIR=/data/uploads
# Largest file the admin can upload, in MB (Nginx and the backend both enforce it)
MAX_UPLOAD_SIZE_MB=20

# Docling parses PDF, DOCX, PPTX and XLSX. DOCLING_API_KEY is sent as X-Api-Key when docling-serve asks for one (leave it
# empty otherwise); a wrong or missing key fails the document at once, without repeating the call
DOCLING_API_KEY=
# A conversion waits at most DOCLING_TIMEOUT_SECONDS. docling-serve has its own limit for a synchronous conversion
# (DOCLING_SERVE_MAX_SYNC_WAIT on the server, about 120 s by default in some versions) and may answer 504 before this
# timeout: raise it on the server together with this value
DOCLING_TIMEOUT_SECONDS=600
# true asks Docling to extract the images of the documents (form field include_images); the text does not need them.
# A switch for it in the interface is left to the settings page of phase 4
DOCLING_INCLUDE_IMAGES=false
# A temporary error of Docling or Ollama (connection refused, timeout, 5xx, 429) repeats the step until INGESTION_MAX_ATTEMPTS
# attempts in all (at least 1), waiting INGESTION_RETRY_BACKOFF_SECONDS (0 or more) and then double between them.
# Keep INGESTION_MAX_ATTEMPTS small: a job is stopped after 3600 s, and the waits double (10, 20, 40, 80 s ...) while each
# attempt can take up to DOCLING_TIMEOUT_SECONDS
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BACKOFF_SECONDS=10
# A document with fewer non-white characters than this after parsing is UNSUPPORTED (no OCR)
MIN_EXTRACTED_CHARS=50
# The original of a FAILED document is kept this many days after it failed (1 to 3650), so that the admin can retry it;
# then the worker deletes it (hourly) and the document stays FAILED. Only the worker reads this setting
FAILED_ORIGINAL_RETENTION_DAYS=7

# Indexing profile: the embedding model (Ollama) and the size of its vectors, 1-2000. Another model or size starts a
# new profile; documents already indexed keep theirs. The size must be the one the model returns
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# The chunks go to Ollama in groups of this many texts (at least 1), each request waits at most this many seconds
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120
# Chunk size in words: CHUNK_MIN_WORDS <= CHUNK_TARGET_WORDS <= CHUNK_MAX_WORDS; the overlap between consecutive chunks
# of a section is this percent of CHUNK_TARGET_WORDS (0-99). Changing them starts a new profile
CHUNK_TARGET_WORDS=300
CHUNK_MIN_WORDS=50
CHUNK_MAX_WORDS=450
CHUNK_OVERLAP_PERCENT=15

# Generation provider of the chat: any OpenAI-compatible API (OpenAI, Ollama with /v1, other compatible services).
# GENERATION_BASE_URL is the base of the API, without the final path, an http or https URL with a host:
# https://api.openai.com/v1 or http://ollama.example.internal:11434/v1 (another value stops the backend). Empty: the
# backend starts, every question answers 503 and GET /api/health shows `generation` as not_configured. With a base URL, GENERATION_MODEL is required (the backend does not start
# without it). GENERATION_API_KEY is sent as "Authorization: Bearer" when set; leave it empty for a provider without
# one. A generation is stopped after GENERATION_TIMEOUT_SECONDS (above 0). Only the backend reads these four
GENERATION_BASE_URL=
GENERATION_MODEL=
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=300

# Level of the backend log on stderr: DEBUG, INFO, WARNING, ERROR or CRITICAL, in any case (another value stops the
# backend). At INFO the chat writes one line per answer (ids, counts, durations, error codes); never the text of a
# question, an answer, a title or a chunk. Only the backend reads it
LOG_LEVEL=INFO

# Retrieval and context of the chat. Each of the two searches (vector and BM25) returns at most RETRIEVAL_CANDIDATES chunks
# (at least 1); the two lists are fused with Reciprocal Rank Fusion, score = sum of 1 / (RRF_K + rank), RRF_K at least 1.
# The model gets the first CHAT_CONTEXT_CHUNKS chunks of the fused list (at least 1) and the last CHAT_HISTORY_MESSAGES
# completed messages of the conversation (0 or more, failed answers excluded). A question longer than CHAT_MAX_QUESTION_CHARS
# characters, after the spaces at both ends are removed, is refused with 422 (at least 1). Only the backend reads these five
RETRIEVAL_CANDIDATES=50
RRF_K=60
CHAT_CONTEXT_CHUNKS=8
CHAT_HISTORY_MESSAGES=6
CHAT_MAX_QUESTION_CHARS=4000

# Question rewriting (phase 4): a follow-up question is rewritten into a standalone one, used only for the search, by an
# OpenAI-compatible API of its own (another service or model than the generation). REWRITE_BASE_URL is the base of the
# API, an http or https URL with a host, e.g. http://rewrite.example.internal:11434/v1 (another value stops the backend).
# Empty: not configured, nothing is sent and GET /api/health shows `rewrite` as not_configured. With a base URL,
# REWRITE_MODEL is required (the backend does not start without it). REWRITE_API_KEY is sent as "Authorization: Bearer"
# when set. A rewriting waits at most REWRITE_TIMEOUT_SECONDS (a finite number above 0, also checked when the base URL
# is empty), then the original question is searched.
# The step runs only when the admin also switches it on in the Settings page. Only the backend reads these four
REWRITE_BASE_URL=
REWRITE_MODEL=
REWRITE_API_KEY=
REWRITE_TIMEOUT_SECONDS=30

# Reranker (phase 4): it reorders the first RERANK_CANDIDATES chunks of the fusion (1 to RETRIEVAL_CANDIDATES) before
# the context is chosen. RERANK_BASE_URL is the base URL of the service, an http or https URL with a host: with the
# reranker of compose.yaml (profile rerank) it is http://reranker. Empty: not configured, nothing is sent and
# GET /api/health shows `rerank` as not_configured; RERANK_API, RERANK_MODEL and RERANK_CANDIDATES are then not checked.
# RERANK_API is the format of the API: tei (Hugging Face text-embeddings-inference, checked with GET /health) or cohere
# (checked with GET /models; RERANK_MODEL is then required, tei does not use it). RERANK_API_KEY is sent as
# "Authorization: Bearer" when set. A reranking waits at most RERANK_TIMEOUT_SECONDS (a finite number above 0, always
# checked), then the RRF order is kept. With RERANK_BASE_URL set, another value of any of them stops the backend.
# The step runs only when the admin also switches it on in the Settings page. Only the backend reads these six
RERANK_BASE_URL=
RERANK_API=tei
RERANK_MODEL=
RERANK_API_KEY=
RERANK_CANDIDATES=20
RERANK_TIMEOUT_SECONDS=15

# Reranker of compose.yaml (phase 4), optional: Hugging Face text-embeddings-inference in the profile rerank, started
# with docker compose --profile rerank up --build (on CPU) or, on a NVIDIA GPU with the NVIDIA Container Toolkit, with
# docker compose -f compose.yaml -f compose.rerank-gpu.yaml --profile rerank up --build (one image at a time). It
# publishes no host port: set RERANK_BASE_URL=http://reranker and RERANK_API=tei above to use it. RERANK_COMPOSE_MODEL
# is the Hugging Face model it serves, downloaded at its first start into the reranker-models volume (the service is
# healthy only after the download). Only compose.yaml reads it
RERANK_COMPOSE_MODEL=BAAI/bge-reranker-v2-m3
