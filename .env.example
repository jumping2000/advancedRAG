# Copy to .env (ignored by git) and fill in the empty values. SPEC-2026-11-06-fase-1-fondazioni.

# Docker Compose: database password (letters and digits only: it is placed inside DATABASE_URL)
POSTGRES_PASSWORD=
# Host port of Nginx, the only published port
HTTP_PORT=80

# Database and Redis. With docker compose they are built by compose.yaml; set them only to run the backend outside
# compose, e.g. postgresql+asyncpg://rag:<password>@127.0.0.1:5432/ragdb and redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=

# External services (not started by docker compose)
OLLAMA_BASE_URL=http://ollama.example.internal:11434
DOCLING_BASE_URL=http://docling.example.internal:5001
# Seconds to wait for each dependency in GET /api/health
HEALTH_CHECK_TIMEOUT_SECONDS=2
